# ──────────────────────────────────────────────────────────────
# 황진 개인금융 — 환경변수
# 로컬: 이 파일을 .env.local 로 복사해서 값을 채운다.
# Vercel: Project → Settings → Environment Variables 에 같은 이름으로 넣는다.
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저에 노출된다(비밀값 금지). 바꾼 뒤에는 재배포해야 반영된다.
# ──────────────────────────────────────────────────────────────

# 대표 도메인 (https 포함, 끝에 / 없이). canonical·OG·sitemap·www 리다이렉트 기준
NEXT_PUBLIC_SITE_URL=https://hwangjin.kr

# 상담 채널 — 비워두면 해당 버튼이 자동으로 숨겨진다
NEXT_PUBLIC_KAKAO_CONTACT_URL=https://pf.kakao.com/_xxxxxx/chat
NEXT_PUBLIC_PHONE=010-0000-0000

# 분석 — 비워두면 스크립트를 아예 불러오지 않는다
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# 선택
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_THREADS_URL=
NEXT_PUBLIC_PRIVACY_EMAIL=
# 소속·등록번호 등 법정 표기 (컴플라이언스 검토 후 입력, 푸터·이용안내에 표시)
NEXT_PUBLIC_AFFILIATION=

# 상담 신청 저장 (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
